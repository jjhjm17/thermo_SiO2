"""This function obtains the dipole moment from the Born effective charge tensor and lammps displacement.

Input
in.yaml

output
dipole
"""
import numpy as np
import yaml
from ase.io import read
from thermo_SiO2.io import read_sil

def get_dipole_born():
    with open('in.yaml', 'r') as stream:
        try:
            param = yaml.safe_load(stream)
        except yaml.YAMLError as exc:
            print(exc)
    # https://stackoverflow.com/questions/1773805/how-can-i-parse-a-yaml-file-in-python

    cfgs = read_sil(param['dump_unfolded'],
                    atom_symbols = param['atom_symbols'])

    if param.get('test_fixed_charge_Si_O_H_Al', False):
        # Nominal (fixed) charges for each species
        """
        # initial charges set according to:
        # https://doi.org/10.1063/5.0194486
        set type 1 charge 1.2 # Si
        set type 2 charge -0.6 # O
        set type 3 charge 0.3 # H
        set type 4 charge 0.9 # Al
        """

        # nominal_charges = {'Si': 4, 'O': -2, 'H': 1, 'Al': 3}
        nominal_charges = {'Si': 1.2, 'O': -0.6, 'H': 0.3, 'Al': 0.9}

        dipoles = []
        for atoms in cfgs:
            symbols = atoms.get_chemical_symbols()
            positions = atoms.get_positions()

            # Total dipole moment = sum(q_i * r_i)
            dipole = np.zeros(3)
            for symbol, pos in zip(symbols, positions):
                charge = nominal_charges[symbol]
                dipole += charge * pos
            dipoles.append(dipole)

        dipole_out = param.get('dipole_out', None)
        if dipole_out is not None:
            with open(dipole_out, 'w') as f:
                f.write('# TimeStep dipole moment  x, y, z (e * Angst)\n')
                for i, dipole in enumerate(dipoles):
                    f.write('{} {:.3f} {:.3f} {:.3f}\n'.format(i, *dipole))
        return dipoles

    # if param.get('born_file', False):



if __name__ == '__main__':
    get_dipole_born()
